        "usage": [
            "Aksi selesai di waktu lampau yang jelas",
            "Rangkaian peristiwa masa lalu",
            "Kebiasaan lampau yang sudah berhenti"
        ],
        "examples": [
            { "sentence": "They **went** to Bali last year.", "meaning": "Mereka pergi ke Bali tahun lalu.", "highlight": "went" },
            { "sentence": "I **did** not **see** him yesterday.", "meaning": "Saya tidak melihatnya kemarin.", "highlight": "did not see" }
        ],
        "signalWords": ["yesterday", "last week", "ago", "in 2020", "when I was young"]
    },
    {
