[
    {
        "id": "simple-present",
        "name": "Simple Present",
        "group": "present",
        "formula": {
            "positive": "S + V1 (+s/es) + O",
            "negative": "S + do/does + not + V1 + O",
            "question": "Do/Does + S + V1 + O ?"
        },
        "usage": [
            "Kebiasaan dan rutinitas",
            "Fakta umum dan kebenaran ilmiah",
            "Jadwal tetap (kereta, jam kerja)",
            "Instruksi dan petunjuk"
        ],
        "examples": [
            { "sentence": "She **works** in Jakarta.", "meaning": "Dia bekerja di Jakarta.", "highlight": "works" },
            { "sentence": "Water **boils** at 100°C.", "meaning": "Air mendidih pada 100°C.", "highlight": "boils" },
            { "sentence": "The train **leaves** at 7 a.m.", "meaning": "Keretanya berangkat pukul 7 pagi.", "highlight": "leaves" }
        ],
        "signalWords": ["always", "usually", "often", "every day", "never", "sometimes"]
    },
    {
        "id": "present-continuous",
        "name": "Present Continuous",
        "group": "present",
        "formula": {
            "positive": "S + am/is/are + V-ing + O",
            "negative": "S + am/is/are + not + V-ing + O",
            "question": "Am/Is/Are + S + V-ing + O ?"
        },
        "usage": [
            "Aksi yang sedang berlangsung sekarang",
            "Rencana yang sudah pasti di masa dekat",
            "Situasi sementara",
            "Kebiasaan yang mengganggu (dengan *always*)"
        ],
        "examples": [
            { "sentence": "I **am studying** English right now.", "meaning": "Saya sedang belajar bahasa Inggris sekarang.", "highlight": "am studying" },
            { "sentence": "We **are meeting** the client tomorrow.", "meaning": "Kami akan bertemu klien besok.", "highlight": "are meeting" }
        ],
        "signalWords": ["now", "at the moment", "currently", "right now", "these days"]
    },
    {
        "id": "present-perfect",
        "name": "Present Perfect",
        "group": "perfect",
        "formula": {
            "positive": "S + have/has + V3 + O",
            "negative": "S + have/has + not + V3 + O",
            "question": "Have/Has + S + V3 + O ?"
        },
        "usage": [
            "Aksi selesai dengan waktu tidak spesifik",
            "Pengalaman hidup",
            "Aksi dimulai di masa lalu dan masih berlanjut",
            "Hasil yang terasa sekarang"
        ],
        "examples": [
            { "sentence": "I **have visited** Japan twice.", "meaning": "Saya sudah dua kali mengunjungi Jepang.", "highlight": "have visited" },
            { "sentence": "She **has lived** here since 2019.", "meaning": "Dia sudah tinggal di sini sejak 2019.", "highlight": "has lived" }
        ],
        "signalWords": ["already", "just", "yet", "ever", "never", "since", "for"]
    },
    {
        "id": "simple-past",
        "name": "Simple Past",
