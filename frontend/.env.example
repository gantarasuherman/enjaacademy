# Data source: "mock" reads src/data/*.json, "api" talks to the Laravel backend.
VITE_DATA_SOURCE=mock

# Laravel API base URL. In dev the Vite proxy forwards /api here, so the
# browser stays same-origin and Sanctum cookies work. This dev server runs
# inside the `workspace` Docker container, so the target must be the `nginx`
# container's Compose service name — not a host-facing "localhost:PORT",
# which workspace has no route to.
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://nginx

VITE_APP_NAME="Enja Academy"
