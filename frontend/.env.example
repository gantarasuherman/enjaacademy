# Data source: "mock" reads src/data/*.json, "api" talks to the Laravel backend.
VITE_DATA_SOURCE=mock

# Laravel API base URL. In dev the Vite proxy forwards /api here, so the
# browser stays same-origin and Sanctum cookies work.
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:8000

VITE_APP_NAME="English Academy"
