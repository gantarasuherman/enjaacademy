APP_NAME="Nihongo & English Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Admin panel
# ---------------------------------------------------------------------------
# Change the prefix and every admin route follows; nothing is hardcoded.
ADMIN_PREFIX=admin
ADMIN_SUPER_ROLE="Super Admin"
ADMIN_PER_PAGE=15
ADMIN_MENU_CACHE_TTL=86400

# ---------------------------------------------------------------------------
# Laradock
# ---------------------------------------------------------------------------
# Container images, published ports, and service versions all live in
# laradock/.env. Only what the PHP application itself needs is set here — the
# hostnames below are Laradock's service names on the shared backend network.

# Where learner routes redirect while public/app has no build yet (dev only).
SPA_DEV_URL=http://localhost:5174

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nihongo_english
DB_USERNAME=laravel
DB_PASSWORD=secret

# ---------------------------------------------------------------------------
# Session / Cache / Queue — all Redis backed
# ---------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Laradock's Redis requires a password; must match REDIS_PASSWORD in laradock/.env.
REDIS_PASSWORD=secret_redis
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail (Mailpit in dev)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nihongo-english.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Sanctum
# ---------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173
SESSION_DOMAIN=localhost

# Origins allowed to call the API (React SPA). Comma separated, no wildcards.
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

VITE_APP_NAME="${APP_NAME}"
